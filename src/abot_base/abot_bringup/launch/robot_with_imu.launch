<launch>
  <include file="$(find abot_bringup)/launch/bringup_with_imu.launch"/>
  <!-- 轮式里程计各向异性降权: 前进5x(信任滚动), 横移+旋转20x(小辊子打滑) -->
  <param name="cov_inflate/forward_factor" type="double" value="5.0"/>
  <param name="cov_inflate/lateral_factor" type="double" value="20.0"/>
  <include file="$(find abot_bringup)/launch/model.launch"/>
  <include file="$(find abot_bringup)/launch/rplidar.launch"/>
</launch>
